# מפתח ה-API של Claude (חובה). השג מ-https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# מודל Claude (ברירת מחדל: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# אזור זמן לפירוש ביטויי זמן יחסיים
TIMEZONE=Asia/Jerusalem

# מספרים מורשים, מופרדים בפסיקים (אופציונלי). אם ריק - הסוכן מגיב לכולם.
# פורמט בינלאומי ללא + לדוגמה: 972501234567
ALLOWED_NUMBERS=

# היכן לשמור את הסשן של וואטסאפ ואת קובץ התזכורות (אופציונלי)
SESSION_DIR=./.wwebjs_auth
DATA_DIR=./data
