# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Twilio WhatsApp ---
# Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Format: whatsapp:+14155238886 (Twilio sandbox number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Server ---
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# --- Localization ---
TIMEZONE=Asia/Jerusalem
LOCALE=he

# --- Google Calendar (optional) ---
# Run: python scripts/google_auth.py to generate google_token.json
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_TOKEN_FILE=google_token.json
GOOGLE_CALENDAR_ID=primary

# --- Storage ---
DB_PATH=data/agent.db

# --- Optional: lock the bot to a single phone number (recommended for personal bot) ---
# Format: whatsapp:+9725XXXXXXXX
ALLOWED_PHONE=
